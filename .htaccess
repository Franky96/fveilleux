# Cache du navigateur : HTML, JS, CSS et JSON sont revérifiés auprès du serveur à chaque visite.
# S'ils n'ont pas changé, le serveur répond « 304 inchangé » (quelques octets) : la page reste rapide,
# et une mise à jour poussée sur master est visible tout de suite, sans Ctrl+F5 ni effacer l'historique.
# (Sans ce fichier, Hostinger laissait le navigateur garder les .js jusqu'à 7 jours.)
# Les images, polices, PDF, etc. gardent la mise en cache normale d'Hostinger.
<IfModule mod_expires.c>
  <FilesMatch "\.(html?|js|mjs|css|json|webmanifest)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|mjs|css|json|webmanifest)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Contrôle des pages par le serveur : chaque page .html de la racine (et de concept/), sauf la connexion,
# passe par api/page.php, qui vérifie la session et la permission avant de la servir (voir docs/site.md).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond $1 !^index\.html$
  RewriteRule ^((?:concept/)?[A-Za-z0-9_-]+\.html)$ api/page.php?p=$1 [L,QSA]
</IfModule>
